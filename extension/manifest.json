{
  "manifest_version": 3,
  "name": "ThreeTabs",
  "version": "1.0.0",
  "description": "Focus by force: limit your browser to just 3 tabs (adjustable) and block the rest.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "ThreeTabs",
    "default_popup": "pages/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "pages/options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": { "id": "threetabs@mkalmousli.github.io", "strict_min_version": "121.0" }
  }
}
